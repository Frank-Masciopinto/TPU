{
  "manifest_version": 3,
  "name": "SecondStreet Vote Bot",
  "version": "1.0",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "tabs",
    "browsingData"
  ],
  "host_permissions": [
    "https://*.secondstreetapp.com/*",
    "https://api.capsolver.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
